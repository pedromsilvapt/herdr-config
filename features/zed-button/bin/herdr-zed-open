#!/bin/sh
# herdr-zed-open <folder> [file[:line[:column]]]
# Opens a folder in Zed, and optionally a file: focuses the window that already
# has the folder, or opens a new one.
# Plain `zed <folder>` focuses a window that has the folder, but with
# cli_default_open_behavior = existing_window it adds an unopened folder to the
# active window, so those get `zed -n`. Open folders are read from Zed's window
# titles ("name — file", "a, b — file"), which needs X11 and xprop; without them
# it always opens a new window.
# A file outside the folder is never opened with it, which would add it to the
# project as a root of its own. When a window has the file or a folder above it,
# plain `zed <file>` lets Zed open it there; otherwise it gets a window of its own.
folder=${1%/}
target=${2:-}

# The root folder names of every Zed window, one per line.
roots=
if [ -n "${DISPLAY:-}" ] && command -v xprop >/dev/null; then
  for w in $(xprop -root _NET_CLIENT_LIST 2>/dev/null | sed 's/.*# //; s/,/ /g'); do
    props=$(xprop -id "$w" WM_CLASS _NET_WM_NAME 2>/dev/null) || continue
    case $props in *'"dev.zed.Zed'*) ;; *) continue ;; esac
    title=$(printf '%s\n' "$props" | sed -n 's/^_NET_WM_NAME(UTF8_STRING) = "\(.*\)"$/\1/p')
    roots="$roots$(printf '%s\n' "${title%% — *}" | sed 's/, /\n/g')
"
  done
fi
open() { printf '%s' "$roots" | grep -Fxq -- "$(basename "$1")"; }

if [ -n "$target" ]; then
  file=$(printf '%s\n' "$target" | sed -E 's/(:[0-9]+){1,2}$//')
  case $file in
    "$folder"/*) ;;
    *)
      # The file itself first: `zed -n <file>` makes a window whose root it is.
      d=$file
      while [ "$d" != / ] && [ "$d" != . ]; do
        if open "$d"; then exec zed "$target"; fi
        d=$(dirname "$d")
      done
      exec zed -n "$target"
      ;;
  esac
fi

set -- "$folder" ${target:+"$target"}
if open "$folder"; then exec zed "$@"; fi
exec zed -n "$@"
