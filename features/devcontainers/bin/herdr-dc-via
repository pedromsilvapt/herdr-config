#!/bin/sh
# herdr-core's bridge into a devcontainer: hc machine add --via "herdr-dc-via <id> <user> <workdir>".
# hc appends the shell line to run there. Never starts the container: a stopped
# one reads as an unavailable machine until something starts it on purpose.
id=$1 user=$2 workdir=$3
shift 3
# dockerPath from herdr-dc's config, as herdr-dc reads it.
docker=$(sed -n 's/.*"dockerPath"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p' \
  "${XDG_CONFIG_HOME:-$HOME/.config}/herdr-dc/config.json" 2>/dev/null | head -n 1)
case $docker in "~/"*) docker=$HOME/${docker#"~/"} ;; esac
docker=${docker:-docker}
if [ "$("$docker" inspect -f '{{.State.Running}}' "$id" 2>/dev/null)" != "true" ]; then
  echo "devcontainer $id is not running" >&2
  exit 255
fi
# When a `herdr-dc attach` for this container runs on the host, its env file
# may not be written yet (a fresh container): wait for it, up to 15 s, rather
# than start herdr-core's server, whose environment every tab inherits for the
# container's life, without SSH_AUTH_SOCK and the rest. The devcontainers mod
# starts attach before it adds the machine.
wait=0
pgrep -fx "[^ ]*herdr-dc attach $id" >/dev/null 2>&1 && wait=15
# docker exec skips the user's shell profile. herdr-dc attach writes the
# environment the devcontainer tools would give (probed login shell, remoteEnv,
# SSH_AUTH_SOCK…) to env beside its binary (dir names where); without it, take
# PATH from the login shell (the one agents start in), falling back to adding
# ~/.local/bin. The shell's stdin is closed so it can't eat what hc pipes in.
exec "$docker" exec -i -u "$user" -w "$workdir" "$id" sh -c \
  'w='"$wait"'; envf() { d=$(cat /tmp/.herdr-dc/dir 2>/dev/null); e=${d:-/tmp/.herdr-dc}/env; }; envf; while [ ! -r "$e" ] && [ "$w" -gt 0 ]; do sleep 1; w=$((w - 1)); envf; done; if [ -r "$e" ]; then . "$e"; else p=$("${SHELL:-sh}" -lc env 2>/dev/null </dev/null | sed -n "s/^PATH=//p"); PATH="${p:-$HOME/.local/bin:$PATH}"; fi; '"$*"
